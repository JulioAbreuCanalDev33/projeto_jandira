# =========================================================
# Projeto Jandira — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env nunca deve ser versionado.
# =========================================================

APP_ENV=production

# ---------- Banco de dados (atletas, arquivos e área restrita) ----------
DB_HOST=127.0.0.1
DB_NAME=projeto_jandira
DB_USER=root
DB_PASS=

# ---------- Servidor SMTP (PHPMailer) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Projeto Jandira"
MAIL_TO_ADDRESS=
MAIL_TO_NAME="Equipe Projeto Jandira"
MAIL_DEBUG=0

