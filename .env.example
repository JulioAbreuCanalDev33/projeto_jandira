# =========================================================
# Projeto Jandira — variáveis de ambiente
# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env nunca deve ser versionado.
# =========================================================

APP_ENV=production

# ---------- Supabase (banco, Storage e sessões) ----------
# Execute supabase/schema_jandira.sql no SQL Editor do seu projeto.
# A chave secreta é usada somente no servidor: nunca exponha no navegador.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_KEY=sua-chave-secreta-do-supabase

# ---------- Servidor SMTP (PHPMailer) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="Projeto Jandira"
MAIL_TO_ADDRESS=
MAIL_TO_NAME="Equipe Projeto Jandira"
MAIL_DEBUG=0

